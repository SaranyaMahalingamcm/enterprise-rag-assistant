# Copy to .env and adjust. Every value below is optional: the defaults run fully offline.
# Never commit a real .env file (it is listed in .gitignore).

RAG_LOG_LEVEL=INFO
# RAG_DOCS_DIR=data/sample_docs
# RAG_AUTO_INGEST=true

# If set, /ingest and /query require an "X-API-Key" header with this value.
# RAG_API_KEY=

# Chunking and retrieval
# RAG_CHUNK_SIZE=900
# RAG_CHUNK_OVERLAP=150
# RAG_TOP_K=4
# RAG_CANDIDATE_K=20
# RAG_RRF_K=60
# RAG_MIN_RELEVANCE_SCORE=0.25

# Providers: local | bedrock | openai | azure_openai   (LLM: extractive | bedrock | openai | azure_openai)
RAG_EMBEDDING_PROVIDER=local
RAG_LLM_PROVIDER=extractive

# --- Amazon Bedrock (pip install '.[bedrock]') ---
# AWS credentials come from the standard AWS credential chain (profile, SSO, IAM role).
# Do not put AWS access keys in this file.
# RAG_AWS_REGION=us-east-1
# RAG_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# RAG_BEDROCK_LLM_MODEL_ID=<model or inference-profile id enabled in your account>

# --- OpenAI / Azure OpenAI (pip install '.[openai]') ---
# RAG_OPENAI_API_KEY=
# RAG_OPENAI_MODEL=gpt-4o-mini                  # Azure: your chat deployment name
# RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small  # Azure: your embedding deployment name
# RAG_AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# RAG_AZURE_OPENAI_API_VERSION=2024-06-01
